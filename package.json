{
  "name": "@parmana/sign",
  "version": "0.2.0",
  "description": "Standalone signing, verification, and canonical-hashing primitives, including Ed25519 and ML-DSA-65 (Dilithium3) post-quantum signature providers and offline verification of Parmana artifacts.",
  "author": "Parmana Systems (https://parmanasystems.com)",
  "homepage": "https://github.com/pavancharak/parmana-sign#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavancharak/parmana-sign.git"
  },
  "bugs": {
    "url": "https://github.com/pavancharak/parmana-sign/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "clean": "rimraf dist",
    "examples": "node examples/run-all.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "cryptography",
    "post-quantum",
    "ml-dsa",
    "dilithium",
    "ed25519",
    "signatures",
    "verification"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^5.0.1",
    "rimraf": "^6.0.1"
  },
  "engines": {
    "node": ">=24.6.0"
  }
}
